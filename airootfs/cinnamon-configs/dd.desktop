[Desktop Entry]
Name=background-set
Comment=set background of system
GenericName=dd.sh
Exec=/usr/bin/dd.sh
Icon=preferences-desktop-wallpaper
Type=Application
Categories=Settings;DesktopSettings;
Path=/usr/bin
X-GNOME-Autostart-enabled=true
NoDisplay=false
Hidden=false
Name[en_US]=desktopset
Comment[en_US]=Installer
X-GNOME-Autostart-Delay=0
