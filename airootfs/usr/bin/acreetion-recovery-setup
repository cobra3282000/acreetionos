#!/usr/bin/env bash
##############################################################################
# acreetion-recovery-setup — provision the AcreetionOS Recovery partition
#
# Mirrors the Windows Recovery (WinRE) model:
#   • a dedicated partition ("ACRECOVERY", ext4) that is fully self-contained:
#     its own GRUB, and copies of the kernel/initramfs/microcode
#   • the MAIN bootloader only chainloads it: manually via an F9 hotkey menu
#     entry, or automatically after a failed boot (recordfail flag)
#   • booting it lands in the acreetion-recovery TUI running from the disk,
#     with Timeshift restore/repair tools - no USB stick required
#
# Modes:
#   acreetion-recovery-setup            interactive (whiptail if available)
#   acreetion-recovery-setup --auto     non-interactive, safe-guarded
#                                       (only creates a partition inside a
#                                        genuine unpartitioned gap; never
#                                        touches existing partitions)
#   acreetion-recovery-setup --device /dev/nvme0n1pX
#                                       use an existing partition (formatted!)
#   acreetion-recovery-setup --sync-kernels   refresh kernel copies only
#
# GPL-3.0-or-later. Part of AcreetionOS.
##############################################################################
set -u

REC_LABEL="ACRECOVERY"
# 512MiB is ample for gzip'd kernel + initramfs + GRUB: payloads land at a
# third of their /boot size, and the filesystem itself carries no journal or
# reserved blocks.
REC_SIZE_MIB=512
REC_MNT=/run/acreetion-recovery
SHARE=/usr/share/acreetion-recovery
GRUB_D_SRC="$SHARE/grub.d"

MODE="interactive"; DEVICE=""
say()  { printf ' \033[1;32m>>>\033[0m %s\n' "$*"; }
warn() { printf ' \033[1;33m!!!\033[0m %s\n' "$*"; }
die()  { printf ' \033[1;31m!!!\033[0m %s\n' "$*" >&2; exit "${2:-1}"; }

[[ $# -gt 0 ]] && case "$1" in
    --auto)        MODE=auto ;;
    --device)      MODE=device; DEVICE="${2:-}"; [[ -b "$DEVICE" ]] || die "--device $DEVICE is not a block device" 2 ;;
    --sync-kernels) MODE=sync ;;
esac

[[ $(id -u) -eq 0 ]] || die "must run as root" 1
command -v parted >/dev/null && command -v grub-install >/dev/null || die "parted/grub-install missing" 1

###############################################################################
# Locate pieces of the system
###############################################################################

find_boot_disk() {
    # The disk holding the currently-mounted root filesystem.
    local src pkname
    src=$(findmnt -rno SOURCE -T / | head -n1)
    case "$src" in
        /dev/mapper/*|/dev/md/*) return 1 ;;   # LVM/RAID roots: not supported for auto-carve
    esac
    pkname=$(lsblk -rno PKNAME "$(resolve_link "$src")" 2>/dev/null | tail -n1)
    [[ -n "$pkname" ]] || return 1
    printf '/dev/%s\n' "$pkname"
}

resolve_link() { local d=$1; while [[ -L $d ]]; do d=$(readlink -f "$d"); done; printf '%s\n' "$d"; }

root_is_plain_partition() {
    # Refuse to carve when root sits on LUKS/LVM/btrfs-RAID etc.
    local fstype
    fstype=$(findmnt -rno FSTYPE -T / | head -n1)
    [[ "$fstype" == ext4 || "$fstype" == ext3 || "$fstype" == btrfs || "$fstype" == xfs ]]
}

existing_rec_partition() {
    lsblk -rno PATH,LABEL 2>/dev/null | awk -v l="$REC_LABEL" '$2==l{print $1; exit}'
}

largest_gap_mib() {
    # Print "<gap_start_bytes> <gap_size_bytes>" of the largest unpartitioned
    # gap on the given disk. Parses parted's machine output; free-space rows
    # end in ":free;free".
    local disk=$1 start size best_s=0 best_z=0 tail
    while IFS=':' read -r _num start _end size tail; do
        case "$tail" in *free*) ;; *) continue ;; esac
        start=${start%B}; size=${size%B}
        (( ${start:-0} && ${size:-0} > best_z )) && { best_s=$start; best_z=$size; }
    done < <(parted -ms "$disk" unit B print free 2>/dev/null | grep -E '^[0-9]+:')
    echo "$best_s $best_z"
}

disk_has_free_slot() {
    # MBR: need a spare primary/extended slot. GPT: effectively unlimited.
    local table
    table=$(parted -ms "$1" print 2>/dev/null | awk -F: 'NR==1{print $6}')
    [[ "$table" == gpt ]] && return 0
    local count
    count=$(lsblk -rno TYPE "$1" 2>/dev/null | grep -c '^part$')
    (( count < 4 ))
}

create_rec_partition() {
    local disk gap_s gap_z part
    disk=$(find_boot_disk) || { warn "cannot determine boot disk (LVM/RAID root?)"; return 1; }
    root_is_plain_partition || { warn "root filesystem type not supported for auto-carve"; return 1; }
    read -r gap_s gap_z <<<"$(largest_gap_mib "$disk")"
    local needed=$(( REC_SIZE_MIB * 1024 * 1024 ))
    (( gap_z >= needed )) || { warn "no unpartitioned gap >= ${REC_SIZE_MIB}MiB on $disk"; return 1; }
    disk_has_free_slot "$disk" || { warn "no spare partition slot on $disk (MBR limit)"; return 1; }

    say "Creating ${REC_SIZE_MIB}MiB recovery partition on $disk"
    parted -s "$disk" unit B \
        mkpart "$( [[ $(parted -ms "$disk" print | awk -F: 'NR==1{print $6}') == gpt ]] && echo ACRECOVERY || echo primary )" \
        "${gap_s}B" "$(( gap_s + needed ))B" || return 1
    sync; partprobe "$disk" 2>/dev/null; udevadm settle 2>/dev/null; sleep 1

    # The new partition starts exactly at the gap we picked.
    part=$(lsblk -rno PATH,START "$disk" | awk -v s=$(( gap_s / 512 )) '$2==s{print $1; exit}')
    [[ -b "$part" ]] || return 1
    printf '%s\n' "$part"
}

###############################################################################
# Provision the partition contents
###############################################################################

install_recovery_grub() {
    local part=$1 mnt=$2 uefi=0
    [[ -d /sys/firmware/efi/efivars ]] && uefi=1

    mkdir -p "$mnt/boot/grub"
    if (( uefi )); then
        say "Installing standalone recovery GRUB (UEFI → $part)"
        grub-install --target=x86_64-efi --efi-directory="$mnt" \
            --boot-directory="$mnt/boot" --bootloader-id=AcreetionOS-Recovery \
            --removable --no-nvram --recheck >/dev/null 2>&1 || return 1
        grub-install --target=i386-efi --efi-directory="$mnt" \
            --boot-directory="$mnt/boot" --bootloader-id=AcreetionOS-Recovery \
            --removable --no-nvram --recheck >/dev/null 2>&1 || true
    else
        say "Installing recovery GRUB into $part boot sector (BIOS)"
        grub-install --target=i386-pc --boot-directory="$mnt/boot" \
            --recheck "$part" >/dev/null 2>&1 || return 1
    fi

    # Render the recovery grub.cfg with this machine's identifiers.
    local root_uuid root_partuuid cmdline
    root_uuid=$(findmnt -rno UUID       -T / | head -n1)
    root_partuuid=$(findmnt -rno PARTUUID -T / | head -n1)
    [[ -z "$root_partuuid" && -n "$root_uuid" ]] && root_partuuid="$root_uuid"
    cmdline=$(grep -qs '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub &&
              sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\?\([^"]*\)"\?/\1/p' /etc/default/grub ||
              echo "quiet splash loglevel=3")

    # GRUB's gzio module decompresses transparently at load time, so every
    # payload is stored gzip -9. The fallback initramfs is deliberately not
    # copied: it is the single biggest file and recovery boots do not need it.
    local ucode_line=""
    local ucodes="" f
    for f in /boot/intel-ucode.img /boot/amd-ucode.img; do
        [[ -f $f ]] && ucodes+="/$(basename "$f").gz "
    done
    ucode_line="$ucodes"

    mkdir -p "$mnt/boot/grub/fonts"
    gzip -9c /usr/share/grub/unicode.pf2 > "$mnt/boot/grub/fonts/unicode.pf2.gz" 2>/dev/null ||
        cp -f /usr/share/grub/unicode.pf2 "$mnt/boot/grub/fonts/" 2>/dev/null
    grub-editenv "$mnt/boot/grub/grubenv" create 2>/dev/null || touch "$mnt/boot/grub/grubenv"

    sed -e "s|@ROOT_IDENT@|$root_partuuid|g" \
        -e "s|@CMDLINE@|$cmdline|g" \
        -e "s|@UCODE@|$ucode_line|g" \
        "$SHARE/grub-recovery.cfg.in" > "$mnt/boot/grub/grub.cfg"
}

sync_kernels_to() {
    local mnt=$1 rc=0 f
    rm -f "$mnt"/vmlinuz-linux* "$mnt"/initramfs-linux* "$mnt"/*-ucode.img* 2>/dev/null
    for f in vmlinuz-linux initramfs-linux.img intel-ucode.img amd-ucode.img; do
        if [[ -f "/boot/$f" ]]; then
            gzip -9c "/boot/$f" > "$mnt/$f.gz" || { rc=1; continue; }
            say "  + $f.gz ($(du -h "/boot/$f" | cut -f1) → $(du -h "$mnt/$f.gz" | cut -f1))"
        else
            warn "missing /boot/$f"
            [[ "$f" == *ucode* ]] || rc=1
        fi
    done
    return $rc
}

register_main_grub_integration() {
    say "Registering chainload entry + failover in the main bootloader"
    install -Dm0755 "$GRUB_D_SRC/45_acreetion-recovery" /etc/grub.d/45_acreetion-recovery
    install -Dm0755 "$GRUB_D_SRC/06_acreetion-default"  /etc/grub.d/06_acreetion-default

    # Boot our tracked default entry so recordfail can observe failures.
    if ! grep -qs '^GRUB_DEFAULT="acreetion-default"$' /etc/default/grub; then
        sed -i '/^GRUB_DEFAULT=/d' /etc/default/grub
        echo 'GRUB_DEFAULT="acreetion-default"' >> /etc/default/grub
    fi
    systemctl enable --now acreetion-boot-success.service 2>/dev/null || true
    grub-mkconfig -o /boot/grub/grub.cfg
}

###############################################################################
# Modes
###############################################################################

mode_sync() {
    local part mnt
    part=$(existing_rec_partition) || { say "No recovery partition present; nothing to sync."; exit 0; }
    mnt=$(mktemp -d)
    mount "$part" "$mnt" 2>/dev/null || { rmdir "$mnt"; exit 0; }
    sync_kernels_to "$mnt"
    umount "$mnt" 2>/dev/null
    rmdir "$mnt" 2>/dev/null
    exit 0   # never break pacman transactions over this
}

main_provision() {
    local part="" fresh=0 mnt=$REC_MNT

    if [[ "$MODE" == device ]]; then
        part=$DEVICE
        say "Using existing partition $part as recovery storage"
    else
        part=$(existing_rec_partition) || part=""
        if [[ -z "$part" ]]; then
            if [[ "$MODE" == auto ]]; then
                part=$(create_rec_partition) || {
                    echo "AcreetionOS Recovery: skipped (no safe space for the recovery partition)." >&2
                    echo "Run 'acreetion-recovery-setup' manually later to create one." >&2
                    exit 0   # informational, not an error
                }
            else
                part=$(choose_interactive) || exit 0
            fi
        fi
        fresh=1
    fi

    mkdir -p "$mnt"
    mountpoint -q "$mnt" && umount "$mnt"
    if (( fresh )) || ! mount "$part" "$mnt" 2>/dev/null; then
        say "Formatting $part as ext4 ($REC_LABEL, no journal, no reserved blocks)"
        wipefs -a "$part" >/dev/null 2>&1
        # -m0: nothing reserved for root (partition is read-mostly).
        # ^has_journal: ext2-style, saves ~16MiB and avoids journal churn;
        # GRUB reads it through the same ext2 driver.
        mkfs.ext4 -q -F -L "$REC_LABEL" -m0 -O '^has_journal' "$part" || die "mkfs failed on $part"
        mount "$part" "$mnt" || die "mount failed" 1
    fi

    say "Copying current kernel + initramfs onto the recovery partition"
    sync_kernels_to "$mnt" || die "kernel copy failed - aborting before touching bootloaders" 1
    install_recovery_grub "$part" "$mnt" || die "recovery GRUB installation failed" 1
    register_main_grub_integration || die "main GRUB registration failed" 1

    umount "$mnt" 2>/dev/null
    say "Recovery partition ready:"
    say "  • press F9 in the GRUB menu  → boots the recovery environment"
    say "  • after a failed boot        → recovery is offered automatically"
    say "  • kernels are kept in sync by the pacman hook"
}

choose_interactive() {
    local disk
    if command -v whiptail >/dev/null && [[ -t 1 ]]; then
        disk=$(whiptail --title " Recovery Partition " --inputbox \
"Disk to create the recovery partition on (free space required):" 10 70 \
"$(find_boot_disk 2>/dev/null)" 3>&1 1>&2 2>&3) || return 1
        printf '%s\n' "$disk"
    else
        find_boot_disk
    fi
}

case "$MODE" in
    sync) mode_sync ;;
    *)    main_provision ;;
esac
