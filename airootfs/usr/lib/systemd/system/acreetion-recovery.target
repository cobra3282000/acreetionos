[Unit]
Description=AcreetionOS Recovery Environment
Documentation=man:acreetion-recovery(8)
Requires=sysinit.target
# Deliberately MINIMAL: no network-online (the classic multi-minute stall on
# headless/broken links), no display manager, no local-fs extras beyond what
# the kernel/initramfs already mounted. Networking is started on demand by
# the TUI (nmtui / package repair). Boot reaches the menu in seconds.
Wants=acreetion-recovery.service acreetion-boot-success.service
After=acreetion-recovery.service
Conflicts=rescue.service single-user.target
AllowIsolate=yes

[Install]
WantedBy=sysinit.target
