[Unit]
Description=AcreetionOS Recovery Environment (TUI on tty1)
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service display-manager.service
Before=display-manager.service
ConditionKernelCommandLine=|acreetion_recovery=1
ConditionPathExists=/usr/bin/acreetion-recovery
IgnoreOnIsolate=yes

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogIdentifier=acreetion-recovery
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Clear the main bootloader's failure marker: a reached recovery menu counts
# as a successful boot. /boot is NOT mounted by the minimal target, so mount
# it best-effort first (fstab may itself be broken - that's why we're here).
ExecStartPre=-/bin/sh -c 'mountpoint -q /boot || mount /boot; [ -f /boot/grub/grubenv ] && grub-editenv /boot/grub/grubenv unset recordfail || true'
ExecStartPre=/usr/bin/chvt 1
ExecStart=-/usr/bin/acreetion-recovery
ExecStopPost=/bin/sh -c 'chvt 1 || true'
TimeoutStartSec=infinity

[Install]
WantedBy=acreetion-recovery.target
