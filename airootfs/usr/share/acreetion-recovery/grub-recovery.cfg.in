# AcreetionOS Recovery Environment - standalone bootloader config
#
# This grub.cfg lives ON the recovery partition (ACRECOVERY) and belongs to
# the partition's own GRUB. The main bootloader chainloads this whole
# partition (F9 hotkey entry or automatic failover after a failed boot).
# It boots the kernel COPIES stored here, so it works even when the main
# system's /boot is damaged.
#
# @ROOT_IDENT@  PARTUUID of the installed system's root
# @CMDLINE@     normal-boot kernel parameters from /etc/default/grub
# @UCODE@       microcode initrd lines ("" if none)

set default=recovery-first
# Near-instant entry: hidden 1s countdown. Pressing any arrow key / ESC
# reveals the full menu (normal-boot fallback etc.).
set timeout=1
set timeout_style=hidden

insmod all_video
insmod gfxterm
insmod gzio
terminal_output gfxterm
if loadfont /boot/grub/fonts/unicode.pf2.gz ; then
    set gfxmode=auto
fi

# All payload files are stored gzip-compressed; gzio decompresses them
# transparently at load time. plymouth.enable=0 keeps the recovery path on
# the plain console (plymouth only adds seconds here).
menuentry 'AcreetionOS Recovery Environment' --hotkey=r --id recovery-first --class recovery --class os {
    set gfxpayload=keep
    linux /vmlinuz-linux.gz root=PARTUUID=@ROOT_IDENT@ rw acreetion_recovery=1 systemd.unit=acreetion-recovery.target plymouth.enable=0 loglevel=3 vt.global_cursor_default=0
    initrd @UCODE@ /initramfs-linux.img.gz
}

menuentry 'Boot AcreetionOS normally' --class gnu-linux --class os {
    set gfxpayload=keep
    linux /vmlinuz-linux.gz root=PARTUUID=@ROOT_IDENT@ ro @CMDLINE@
    initrd @UCODE@ /initramfs-linux.img.gz
}

menuentry 'Reboot' --class reboot { reboot }
menuentry 'Power off' --class poweroff { halt }
